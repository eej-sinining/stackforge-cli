{
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=__project___db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "https://localhost:5000",
    "Audience": "https://localhost:5000",
    "SecretKey": "your-super-secret-key-change-this-in-production",
    "ExpiryMinutes": 60
  },
{% if s3 %}
  "S3": {
    "BucketName": "__project__-files",
    "Region": "us-east-1",
    "ServiceUrl": "",
    "ForcePathStyle": false,
    "PresignedUrlExpiryMinutes": 15
  },
{% endif %}
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
